{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "server.js",
      "store.js",
      "shared/**",
      "public/index.html",
      "public/audio.js",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 5
  }
}
